meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "{{userName}}",
    "password": "{{userPassword}}",
    "passwordConfirm": "{{userPassword}}"
  }
}

tests {
  test("status 201 (ou 409 se o usuário já existir)", function() {
    expect([201, 409]).to.include(res.getStatus());
  });
  
  test("retorna id em uuid quando criado", function() {
    if (res.getStatus() === 201) {
      expect(res.getBody().id).to.match(/^[0-9a-f-]{36}$/);
    }
  });
}
