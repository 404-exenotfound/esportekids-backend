meta {
  name: Create User - senhas diferentes
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "outro-usuario2",
    "password": "123456",
    "passwordConfirm": "654321"
  }
}

vars:pre-request {
  baseUrl: http://localhost:5000
}

tests {
  test("status 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
  
  test("erro em passwordConfirm", function() {
    expect(res.getBody().details).to.have.property("passwordConfirm");
  });
}
